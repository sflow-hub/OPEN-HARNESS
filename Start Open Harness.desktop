[Desktop Entry]
Type=Application
Version=1.0
Name=Start Open Harness
Comment=Choose a model and open your local workspace
Icon=applications-development
TryExec=/bin/bash
Exec=/bin/bash -c "p=\\$(readlink -f -- \\"\\${1:-\\${GIO_LAUNCHED_DESKTOP_FILE:-Start Open Harness.desktop}}\\") && exec /bin/bash \\"\\$(dirname -- \\"\\$p\\")/launchers/start.sh\\" --desktop" open-harness %k
Terminal=true
Categories=Utility;
StartupNotify=false
