# Optional bootstrap credentials for the local control service.
# Settings stores replacements in .open-harness/secrets.json with mode 0600.
XAI_API_KEY=
OPENROUTER_API_KEY=
# Ollama, LM Studio, or another chat-completions-compatible server:
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# Self-hosted runner connectivity. Put the public URL behind HTTPS.
OPEN_HARNESS_BIND=127.0.0.1
OPEN_HARNESS_PUBLIC_URL=
