# Optional bootstrap credentials for the local control service.
# Settings stores replacements in .open-harness/secrets.json with mode 0600.
XAI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Ollama, LM Studio, or another chat-completions-compatible server:
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# Where state.db, secrets and agent profiles live. Unset means <project>/.open-harness.
# "npm run harness:setup" fills this in with ~/.open-harness/<project> when Docker Desktop
# cannot read the project folder, because agents started there would never receive their
# profile or model credential. Leave it commented out rather than empty.
# OPEN_HARNESS_STATE_DIR=

# Self-hosted runner connectivity. Put the public URL behind HTTPS.
OPEN_HARNESS_BIND=127.0.0.1
OPEN_HARNESS_PUBLIC_URL=

# Docker Compose listens only on localhost unless you explicitly change this.
OPEN_HARNESS_LISTEN_ADDRESS=127.0.0.1
# Set both values only when an authenticated HTTPS reverse proxy protects the dashboard.
OPEN_HARNESS_ALLOW_REMOTE_DASHBOARD=0
