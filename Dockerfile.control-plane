ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS builder
WORKDIR /source
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY control-plane ./control-plane
COPY runtime/product-error.ts ./runtime/product-error.ts
COPY lib/product.ts lib/display-name.ts ./lib/
RUN npx esbuild control-plane/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server.mjs \
    && npm prune --omit=dev --ignore-scripts
FROM ${NODE_IMAGE}
WORKDIR /opt/open-harness
COPY --from=builder /source/package.json /source/server.mjs ./control-plane/
COPY --from=builder /source/control-plane/schema.sql ./control-plane/schema.sql
COPY --from=builder /source/node_modules ./node_modules
USER node
EXPOSE 4400
CMD ["node", "/opt/open-harness/control-plane/server.mjs"]
