{
  "name": "open-harness",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node runtime/dev.mjs",
    "docker:start": "node runtime/start-docker.mjs",
    "dev:app": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "harness": "node --import tsx runtime/cli.ts",
    "harness:serve": "node runtime/start-docker.mjs && node --import tsx runtime/service.ts",
    "harness:setup": "npm run harness -- setup",
    "harness:start": "npm run harness -- start",
    "harness:stop": "npm run harness -- stop",
    "harness:doctor": "npm run harness -- doctor",
    "harness:install-service": "npm run harness -- install-service",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "license": "MIT"
}
