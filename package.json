{
  "name": "open-harness",
  "version": "0.4.0-beta.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sflow-hub/OPEN-HARNESS.git"
  },
  "bugs": {
    "url": "https://github.com/sflow-hub/OPEN-HARNESS/issues"
  },
  "homepage": "https://github.com/sflow-hub/OPEN-HARNESS#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node runtime/check-node.mjs",
    "dev": "node --env-file-if-exists=.env runtime/dev.mjs",
    "docker:start": "node runtime/start-docker.mjs",
    "dev:app": "vinext dev",
    "prebuild": "node runtime/check-node.mjs",
    "build": "vinext build --precompress && node desktop/fix-standalone.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:fix": "eslint . --fix --ignore-pattern dist --ignore-pattern .next",
    "pretest": "node runtime/check-node.mjs",
    "test": "node --import tsx --test --test-timeout=120000 tests/*.test.ts",
    "test:watch": "node --import tsx --test --test-timeout=120000 --watch tests/*.test.ts",
    "test:coverage": "node --import tsx --test --test-timeout=120000 --experimental-test-coverage tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "harness": "node --import tsx runtime/cli.ts",
    "preharness:serve": "node runtime/check-node.mjs",
    "harness:serve": "node runtime/start-docker.mjs && node --env-file-if-exists=.env --import tsx runtime/service.ts",
    "harness:setup": "npm run harness -- setup",
    "harness:start": "npm run harness -- start",
    "harness:stop": "npm run harness -- stop",
    "harness:doctor": "npm run harness -- doctor",
    "runner": "node --import tsx runtime/runner.ts",
    "harness:install-service": "npm run harness -- install-service",
    "test:browser": "npm run build && playwright test",
    "runner:bundle": "node desktop/build-runner.mjs",
    "desktop:prepare": "node desktop/prepare-runtime.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run desktop:prepare && tauri build",
    "release:package": "node scripts/package-self-hosted.mjs",
    "precloud:serve": "node runtime/check-node.mjs",
    "cloud:serve": "node --env-file-if-exists=.env --import tsx control-plane/server.ts",
    "workspace:relay": "node --env-file-if-exists=.env --import tsx runtime/workspace-relay.ts",
    "acceptance": "node --import tsx scripts/experience-acceptance.ts",
    "cloud:operations": "node --import tsx scripts/cloud-operations.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "jose": "6.2.15",
    "lucide-react": "^1.45.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "23.1.0",
    "web-push": "^3.6.7",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "next": "16.4.4",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.5"
  },
  "type": "module"
}
