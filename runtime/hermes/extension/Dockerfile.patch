# Refresh only managed policy on an image already built for this runtime contract.
# Older images also need OS/CUA/init changes and must use the full Dockerfile.
# Build with the extension directory as the context:
#   docker build -f runtime/hermes/extension/Dockerfile.patch -t open-harness-hermes:2026.9.11 runtime/hermes/extension
ARG BASE_IMAGE=open-harness-hermes:2026.9.11
FROM ${BASE_IMAGE}
ARG OPEN_HARNESS_RUNTIME=7
USER root
RUN test "$(cat /opt/open-harness/runtime-contract 2>/dev/null)" = "$OPEN_HARNESS_RUNTIME" \
  || { echo 'This image requires a full runtime rebuild before updating managed policy.' >&2; exit 1; }
COPY . /opt/open-harness/extension/
RUN chmod -R a+rX /opt/open-harness/extension \
  && pip install --no-cache-dir --force-reinstall --no-deps /opt/open-harness/extension
USER hermes
LABEL dev.openharness.runtime=$OPEN_HARNESS_RUNTIME
