{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Permissions for the local Open Harness window and its managed Node sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "node", "sidecar": true }]
    },
    "shell:allow-kill"
  ]
}
