FROM node:24.21.0-trixie-slim@sha256:8ec5d7557396cfe32d21c3f9c13072355ceab22b584578ca4bb28af31120cffe AS node-base
# Verify the whole npm distribution before replacing the base image's bundled copy.
RUN node --input-type=module -e 'import { createHash } from "node:crypto"; import { writeFileSync } from "node:fs"; const r = await fetch("https://registry.npmjs.org/npm/-/npm-11.20.0.tgz"); if (!r.ok) throw new Error(`npm download failed: ${r.status}`); const b = Buffer.from(await r.arrayBuffer()); if (createHash("sha512").update(b).digest("base64") !== "dF3EDFwbYN+N5RUip+ZYDe0NeURK5BgqKOcvT1iNtUYhTMTl0FwWhBuXrS7KtXyduqyTMS5aaQaregnHDAxNgw==") throw new Error("npm archive integrity mismatch"); writeFileSync("/tmp/npm-11.20.0.tgz", b);' \
  && npm install -g /tmp/npm-11.20.0.tgz \
  && test "$(node --version)" = v24.21.0 && test "$(npm --version)" = 11.20.0 \
  && rm /tmp/npm-11.20.0.tgz && npm cache clean --force

FROM docker:29.8.1-cli@sha256:018edbc908e08fcc9dbf029c812c34251e9b4719e6f71ca0e5eae2a987d014ca AS docker-cli

FROM node-base AS builder
WORKDIR /source
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NEXT_PUBLIC_OPEN_HARNESS_SELF_HOSTED=1
RUN npm run build && npm run runner:bundle \
  && npx esbuild runtime/service.ts --bundle --platform=node --format=esm --target=node22 --packages=external --banner:js="import { createRequire as __openHarnessCreateRequire } from 'node:module'; const require = __openHarnessCreateRequire(import.meta.url);" --outfile=runtime/service.mjs \
  && npx esbuild runtime/browser-pair-cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=runtime/browser-pair.mjs

FROM node-base
# The engine lives in DinD; Buildx preserves source-mode runtime setup builds.
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
# Compose uses curl for its coordinator healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* && docker --version && docker buildx version
WORKDIR /opt/open-harness
COPY --from=builder /source/dist/standalone ./app
COPY --from=builder /source/runtime/service.mjs /source/runtime/runner.mjs /source/runtime/browser-pair.mjs ./runtime/
COPY --from=builder /source/runtime/hermes ./runtime/hermes
COPY --from=builder /source/runtime/installers ./runtime/installers
COPY --from=builder /source/desktop/supervisor.mjs ./supervisor.mjs
# Shared-folder checkouts can give copied source files owner-only permissions.
RUN chmod -R a+rX /opt/open-harness \
  && mkdir -p /data && chown node:node /data
ENV OPEN_HARNESS_STATE_DIR=/data OPEN_HARNESS_INTERNAL_CONTROL_URL=http://127.0.0.1:4317
USER node
EXPOSE 3000
CMD ["node", "/opt/open-harness/supervisor.mjs"]
