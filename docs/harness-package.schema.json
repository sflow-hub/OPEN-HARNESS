{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-harness.local/schemas/harness-package-v1.json",
  "title": "Open Harness package v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "license",
    "architecture",
    "image",
    "command",
    "protocol",
    "features",
    "providers",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "not": {
        "enum": [
          "hermes",
          "opencode"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]{0,79}$"
    },
    "license": {
      "type": "string",
      "maxLength": 100
    },
    "architecture": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "x64",
          "arm64"
        ]
      }
    },
    "image": {
      "type": "string",
      "pattern": "^(?:[a-z0-9][a-z0-9./:_-]*@)?sha256:[a-f0-9]{64}$"
    },
    "imageArchive": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "protocol": {
      "const": "open-harness-runtime/v1"
    },
    "features": {
      "type": "object",
      "required": [
        "memory",
        "skills",
        "sessionRecall",
        "scheduling",
        "desktop",
        "mcp",
        "approvals",
        "steer",
        "clarify"
      ],
      "properties": {
        "memory": {
          "type": "boolean"
        },
        "skills": {
          "type": "boolean"
        },
        "sessionRecall": {
          "type": "boolean"
        },
        "scheduling": {
          "type": "boolean"
        },
        "desktop": {
          "const": false
        },
        "mcp": {
          "type": "boolean"
        },
        "approvals": {
          "const": true
        },
        "steer": {
          "type": "boolean"
        },
        "clarify": {
          "type": "boolean"
        }
      }
    },
    "providers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 100,
        "not": {
          "const": "openai-codex"
        }
      }
    },
    "files": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "configuration": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "group",
          "description",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "image": {
            "pattern": "^sha256:"
          }
        }
      },
      "then": {
        "required": [
          "imageArchive"
        ]
      }
    },
    {
      "if": {
        "required": [
          "imageArchive"
        ]
      },
      "then": {
        "properties": {
          "image": {
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
